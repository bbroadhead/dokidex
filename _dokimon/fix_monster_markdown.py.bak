import os
import yaml

def fix_md_file(path):
    with open(path, 'r', encoding='utf-8') as f:
        content = f.read()

    # Split front matter
    parts = content.split('---')
    if len(parts) < 3:
        print(f"Skipping {path}: Invalid front matter")
        return

    front = yaml.safe_load(parts[1])

    # Apply defaults to required fields
    front['number'] = front.get('number', '')
    front['name'] = front.get('name', '')
    front['lang_names'] = front.get('lang_names', []) or []
    front['stage'] = front.get('stage', '') or ''
    front['evolves_at'] = front.get('evolves_at', '') or ''
    front['type'] = front.get('type', []) or []
    front['location'] = front.get('location', '') or ''
    front['image'] = front.get('image', '') or ''
    front['description'] = front.get('description', '') or ''
    front['lang_description'] = front.get('lang_description', '') or ''

    # Rebuild front matter
    new_front = "---\n" + yaml.dump(front, sort_keys=False) + "---\n\n"
    with open(path, 'w', encoding='utf-8') as f:
        f.write(new_front)

# Run on all .md files in current folder
for filename in os.listdir():
    if filename.endswith(".md"):
        fix_md_file(filename)
        print(f"Fixed: {filename}")

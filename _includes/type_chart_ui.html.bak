</colgroup>
</table>
</div>
</div>
<style>
.type-effect-tool {
  position: fixed;
  left: 0;
  top: 150px;
  background-color: var(--panel-bg);
  transition: transform 0.3s ease-in-out;
  transform: translateX(-100%);
  z-index: 999;
  pointer-events: none;
  border-right: none;
  font-family: 'VT323', monospace;
  font-size: 18px;
  line-height: 1.0;
}

.type-effect-tool .type-effect-tab {
  pointer-events: auto;
  font-family: 'VT323', monospace;
  font-size: 22px;
  line-height: 1.2;
}

.tracker-table td img {
  width: 32px;
  height: 32px;
  image-rendering: pixelated;
}

.type-effect-tool.left-collapse {
  pointer-events: none;
}

.type-effect-tool.open {
  transform: translateX(0);
  pointer-events: auto;
  border: 2px solid #444;
  border-left: none;
}

body:not(.dark-mode) .type-effect-tab {
  background-color: #336699;
  color: white;
  border-color: #0056b3;
}

.type-icon {
  width: 72px;
  height: 24px;
  image-rendering: pixelated;
  padding: 0.1rem;
}

.type-effect-tab {
  position: absolute;
  z-index: 10000;
  right: -30px;
  top: 120px;
  width: 30px;
  height: 200px;
  background-color: var(--tab-bg);
  color: var(--text);
  writing-mode: vertical-rl;
  text-align: center;
  cursor: pointer;
  padding: 8px 4px;
  font-weight: bold;
  border: 2px solid #ccc;
  border-left: none;
  border-top-right-radius: 12px;
  border-bottom-right-radius: 12px;
  box-shadow: 2px 2px 6px rgba(0,0,0,0.3);
  transition: background-color 0.3s, color 0.3s;
}

.type-effect-tab:hover {
  background-color: #aaa;
  color: #000;
}

body.dark-mode .type-effect-tab:hover {
  background-color: #333;
  color: #fff;
}

.rotated-type-icon {
  width: 26px;
  height: 76px;
  display: block;
  padding: 0.1rem;
}

.type-effect-content {
  padding: 12px;
  max-width: none;
  min-width: 650px;
  overflow-x: auto;
}

.type-effect-tool {
  width: 490px; /* Adjust to fit your full chart */
}

.type-effect-table {
  table-layout: fixed;
  border-collapse: collapse;
  width: auto;
  font-family: 'VT323', monospace;
  font-size: 14px;
  line-height: 1.0;
}

.type-effect-table th,
.type-effect-table td {
  border: 1px solid #888;
}

.type-effect-table th.type-header {
  cursor: pointer;
  background-color: white;
}

body.dark-mode .type-effect-table th.type-header {
  cursor: pointer;
  background-color: #000;
}

/* Generic fallback for highlighted cells */
.effect-cell.highlight-row,
.effect-cell.highlight-col {
  color: white;
  font-weight: bold;
}

.effect-cell.highlight-col[data-col="Fire"],
.effect-cell.highlight-row[data-row="Fire"] {
  background-color: #ed474c;
}

.effect-cell.highlight-col[data-col="Grass"],
.effect-cell.highlight-row[data-row="Grass"] {
  background-color: #86dd58;
}

.effect-cell.highlight-col[data-col="Water"],
.effect-cell.highlight-row[data-row="Water"] {
  background-color: #4c81ff;
}

.effect-cell.highlight-col[data-col="Electric"],
.effect-cell.highlight-row[data-row="Electric"] {
  background-color: #e5db5b;
}

.effect-cell.highlight-col[data-col="Dark"],
.effect-cell.highlight-row[data-row="Dark"] {
  background-color: #9b66cc;
}

.effect-cell.highlight-col[data-col="Light"],
.effect-cell.highlight-row[data-row="Light"] {
  background-color: #e5db5b;
}

.effect-cell.highlight-col[data-col="Flying"],
.effect-cell.highlight-row[data-row="Flying"] {
  background-color: #4c81ff;
}

.effect-cell.highlight-col[data-col="fight"],
.effect-cell.highlight-row[data-row="fight"] {
  background-color: #ed474c;
}

.effect-cell.highlight-col[data-col="Poison"],
.effect-cell.highlight-row[data-row="Poison"] {
  background-color: #cc517c;
}

.effect-cell.highlight-col[data-col="Dragon"],
.effect-cell.highlight-row[data-row="Dragon"] {
  background-color: #9b66cc;
}

.effect-cell.highlight-col[data-col="Fairy"],
.effect-cell.highlight-row[data-row="Fairy"] {
  background-color: #cc517c;
}

.effect-cell.highlight-col[data-col="Ghost"],
.effect-cell.highlight-row[data-row="Ghost"] {
  background-color: #9b66cc;
}

.effect-cell.highlight-col[data-col="Ice"],
.effect-cell.highlight-row[data-row="Ice"] {
  background-color: #4c81ff;
}

.effect-cell span {
  color: inherit; /* resets to parent if not overridden */
}

.effect-cell span[style*="color:#4CAF50"] {
  color: #4CAF50 !important; /* 2x */
}

.effect-cell span[style*="color:#FFA500"] {
  color: #FFA500 !important; /* Half */
}

.effect-cell span[style*="color:#F44336"] {
  color: #F44336 !important; /* Null */
}

/* Outline all text in highlighted cells */
.effect-cell.highlight-row,
.effect-cell.highlight-col {
  text-shadow:
    -1px -1px 0 #000,
     1px -1px 0 #000,
    -1px  1px 0 #000,
     1px  1px 0 #000;
}

body.dark-mode .type-effect-tool {
  --panel-bg: #111;
  --tab-bg: #222;
  --text: #fff;
}

body:not(.dark-mode) .type-effect-tool {
  --panel-bg: #eee;
  --tab-bg: #ccc;
  --text: #000;
}

.type-effect-table thead tr:first-child {
  height: 78px;
}

.type-effect-table th,
.type-effect-table td {
  width: 28px !important;
  padding: 0;
  margin: 0 auto;
  text-align: center;
}

.type-effect-table {
  table-layout: fixed;
  width: auto;
  border-collapse: collapse;
}

.type-effect-table th.type-header {
  padding: 0;
  text-align: center;
}

.type-effect-table th:first-child {
  width: 76px;
}

.type-effect-table td:first-child {
  display: block;
  width: 76px;
  height: 26px;
  margin: 0 auto;
}

col.col-type {
  width: 28px;
}

col.col-label {
  width: auto;
}

.type-effect-table th.type-header img:not(.rotated-type-icon) {
  display: block;
  margin: 0 auto;
  padding: 0.1rem;
}
</style>
<script>
  const typeTool = document.getElementById('type-effect-tool');
  const typeHeaders = document.querySelectorAll('.type-header');
  const cells = document.querySelectorAll('.effect-cell');

  function toggleTypeEffectTool() {
    typeTool.classList.toggle('open');
  }

  let selectedRow = null;
  let selectedCol = null;

  function clearHighlights() {
    cells.forEach(cell => {
      cell.classList.remove('highlight-row', 'highlight-col', 'highlight-both');
    });
  }

  function highlightTable() {
    clearHighlights();
    cells.forEach(cell => {
      const row = cell.dataset.row;
      const col = cell.dataset.col;
      if (row === selectedRow && col === selectedCol) {
        cell.classList.add('highlight-both');
      } else if (row === selectedRow) {
        cell.classList.add('highlight-row');
      } else if (col === selectedCol) {
        cell.classList.add('highlight-col');
      }
    });
  }

  typeHeaders.forEach(header => {
    header.addEventListener('click', () => {
      const type = header.closest('.type-header').dataset.type;
      if (header.closest('thead')) {
        selectedCol = selectedCol === type ? null : type;
      } else {
        selectedRow = selectedRow === type ? null : type;
      }
      highlightTable();
    });
  });
</script>

<div class="type-effect-tool" id="type-effect-tool">
<div class="type-effect-tab" onclick="toggleTypeEffectTool()">Type Effectiveness Tool</div>
<div class="type-effect-content">
<table class="type-effect-table">
<colgroup>
<col class="col-label">
<thead><tr><th class="type-arrow">Row=Attack Move Type,<br>Col=Defend Mon Type ➤<br>Click a type to highlight</th><th class="type-header" data-type="Fire"><img alt="Fire" class="rotated-type-icon" src="/assets/images/type_icons_90/fire_90.png" title="Fire"/></th><th class="type-header" data-type="Grass"><img alt="Grass" class="rotated-type-icon" src="/assets/images/type_icons_90/grass_90.png" title="Grass"/></th><th class="type-header" data-type="Water"><img alt="Water" class="rotated-type-icon" src="/assets/images/type_icons_90/water_90.png" title="Water"/></th><th class="type-header" data-type="Electric"><img alt="Electric" class="rotated-type-icon" src="/assets/images/type_icons_90/electric_90.png" title="Electric"/></th><th class="type-header" data-type="Dark"><img alt="Dark" class="rotated-type-icon" src="/assets/images/type_icons_90/dark_90.png" title="Dark"/></th><th class="type-header" data-type="Light"><img alt="Light" class="rotated-type-icon" src="/assets/images/type_icons_90/light_90.png" title="Light"/></th><th class="type-header" data-type="Flying"><img alt="Flying" class="rotated-type-icon" src="/assets/images/type_icons_90/flying_90.png" title="Flying"/></th><th class="type-header" data-type="fight"><img alt="fight" class="rotated-type-icon" src="/assets/images/type_icons_90/fight_90.png" title="fight"/></th><th class="type-header" data-type="Poison"><img alt="Poison" class="rotated-type-icon" src="/assets/images/type_icons_90/poison_90.png" title="Poison"/></th><th class="type-header" data-type="Dragon"><img alt="Dragon" class="rotated-type-icon" src="/assets/images/type_icons_90/dragon_90.png" title="Dragon"/></th><th class="type-header" data-type="Fairy"><img alt="Fairy" class="rotated-type-icon" src="/assets/images/type_icons_90/fairy_90.png" title="Fairy"/></th><th class="type-header" data-type="Ghost"><img alt="Ghost" class="rotated-type-icon" src="/assets/images/type_icons_90/ghost_90.png" title="Ghost"/></th><th class="type-header" data-type="Ice"><img alt="Ice" class="rotated-type-icon" src="/assets/images/type_icons_90/ice_90.png" title="Ice"/></th></tr></thead>
<col class="col-type" span="16">
<tbody>
<tr><th class="type-header" data-type="Fire"><img alt="Fire" class="type-icon" src="/assets/images/type_icons/fire.png"/></th><td class="effect-cell" data-col="Fire" data-row="Fire">1x</td><td class="effect-cell" data-col="Grass" data-row="Fire"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Water" data-row="Fire"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Electric" data-row="Fire">1x</td><td class="effect-cell" data-col="Dark" data-row="Fire">1x</td><td class="effect-cell" data-col="Light" data-row="Fire">1x</td><td class="effect-cell" data-col="Flying" data-row="Fire">1x</td><td class="effect-cell" data-col="fight" data-row="Fire">1x</td><td class="effect-cell" data-col="Poison" data-row="Fire">1x</td><td class="effect-cell" data-col="Dragon" data-row="Fire">1x</td><td class="effect-cell" data-col="Fairy" data-row="Fire"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Ghost" data-row="Fire">1x</td><td class="effect-cell" data-col="Ice" data-row="Fire"><span style="color:#4CAF50;">2x</span></td></tr>
<tr><th class="type-header" data-type="Grass"><img alt="Grass" class="type-icon" src="/assets/images/type_icons/grass.png"/></th><td class="effect-cell" data-col="Fire" data-row="Grass"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Grass" data-row="Grass">1x</td><td class="effect-cell" data-col="Water" data-row="Grass"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Electric" data-row="Grass"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Dark" data-row="Grass">1x</td><td class="effect-cell" data-col="Light" data-row="Grass"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Flying" data-row="Grass"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="fight" data-row="Grass">1x</td><td class="effect-cell" data-col="Poison" data-row="Grass"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dragon" data-row="Grass">1x</td><td class="effect-cell" data-col="Fairy" data-row="Grass">1x</td><td class="effect-cell" data-col="Ghost" data-row="Grass">1x</td><td class="effect-cell" data-col="Ice" data-row="Grass"><span style="color:#FFA500;">Half</span></td></tr>
<tr><th class="type-header" data-type="Water"><img alt="Water" class="type-icon" src="/assets/images/type_icons/water.png"/></th><td class="effect-cell" data-col="Fire" data-row="Water"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Grass" data-row="Water"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Water" data-row="Water">1x</td><td class="effect-cell" data-col="Electric" data-row="Water"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dark" data-row="Water">1x</td><td class="effect-cell" data-col="Light" data-row="Water">1x</td><td class="effect-cell" data-col="Flying" data-row="Water">1x</td><td class="effect-cell" data-col="fight" data-row="Water">1x</td><td class="effect-cell" data-col="Poison" data-row="Water"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Dragon" data-row="Water">1x</td><td class="effect-cell" data-col="Fairy" data-row="Water">1x</td><td class="effect-cell" data-col="Ghost" data-row="Water">1x</td><td class="effect-cell" data-col="Ice" data-row="Water"><span style="color:#FFA500;">Half</span></td></tr>
<tr><th class="type-header" data-type="Electric"><img alt="Electric" class="type-icon" src="/assets/images/type_icons/electric.png"/></th><td class="effect-cell" data-col="Fire" data-row="Electric">1x</td><td class="effect-cell" data-col="Grass" data-row="Electric"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Water" data-row="Electric"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Electric" data-row="Electric"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dark" data-row="Electric">1x</td><td class="effect-cell" data-col="Light" data-row="Electric">1x</td><td class="effect-cell" data-col="Flying" data-row="Electric"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="fight" data-row="Electric">1x</td><td class="effect-cell" data-col="Poison" data-row="Electric"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dragon" data-row="Electric">1x</td><td class="effect-cell" data-col="Fairy" data-row="Electric">1x</td><td class="effect-cell" data-col="Ghost" data-row="Electric">1x</td><td class="effect-cell" data-col="Ice" data-row="Electric"><span style="color:#FFA500;">Half</span></td></tr>
<tr><th class="type-header" data-type="Dark"><img alt="Dark" class="type-icon" src="/assets/images/type_icons/dark.png"/></th><td class="effect-cell" data-col="Fire" data-row="Dark"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Grass" data-row="Dark">1x</td><td class="effect-cell" data-col="Water" data-row="Dark">1x</td><td class="effect-cell" data-col="Electric" data-row="Dark"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Dark" data-row="Dark">1x</td><td class="effect-cell" data-col="Light" data-row="Dark"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Flying" data-row="Dark">1x</td><td class="effect-cell" data-col="fight" data-row="Dark">1x</td><td class="effect-cell" data-col="Poison" data-row="Dark">1x</td><td class="effect-cell" data-col="Dragon" data-row="Dark">1x</td><td class="effect-cell" data-col="Fairy" data-row="Dark"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Ghost" data-row="Dark">1x</td><td class="effect-cell" data-col="Ice" data-row="Dark">1x</td></tr>
<tr><th class="type-header" data-type="Light"><img alt="Light" class="type-icon" src="/assets/images/type_icons/light.png"/></th><td class="effect-cell" data-col="Fire" data-row="Light">1x</td><td class="effect-cell" data-col="Grass" data-row="Light"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Water" data-row="Light">1x</td><td class="effect-cell" data-col="Electric" data-row="Light"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dark" data-row="Light"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Light" data-row="Light">1x</td><td class="effect-cell" data-col="Flying" data-row="Light">1x</td><td class="effect-cell" data-col="fight" data-row="Light">1x</td><td class="effect-cell" data-col="Poison" data-row="Light">1x</td><td class="effect-cell" data-col="Dragon" data-row="Light"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Fairy" data-row="Light"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Ghost" data-row="Light">1x</td><td class="effect-cell" data-col="Ice" data-row="Light">1x</td></tr>
<tr><th class="type-header" data-type="Flying"><img alt="Flying" class="type-icon" src="/assets/images/type_icons/flying.png"/></th><td class="effect-cell" data-col="Fire" data-row="Flying">1x</td><td class="effect-cell" data-col="Grass" data-row="Flying"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Water" data-row="Flying">1x</td><td class="effect-cell" data-col="Electric" data-row="Flying"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dark" data-row="Flying"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Light" data-row="Flying">1x</td><td class="effect-cell" data-col="Flying" data-row="Flying">1x</td><td class="effect-cell" data-col="fight" data-row="Flying"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Poison" data-row="Flying">1x</td><td class="effect-cell" data-col="Dragon" data-row="Flying">1x</td><td class="effect-cell" data-col="Fairy" data-row="Flying">1x</td><td class="effect-cell" data-col="Ghost" data-row="Flying">1x</td><td class="effect-cell" data-col="Ice" data-row="Flying"><span style="color:#FFA500;">Half</span></td></tr>
<tr><th class="type-header" data-type="fight"><img alt="fight" class="type-icon" src="/assets/images/type_icons/fight.png"/></th><td class="effect-cell" data-col="Fire" data-row="fight">1x</td><td class="effect-cell" data-col="Grass" data-row="fight">1x</td><td class="effect-cell" data-col="Water" data-row="fight">1x</td><td class="effect-cell" data-col="Electric" data-row="fight">1x</td><td class="effect-cell" data-col="Dark" data-row="fight"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Light" data-row="fight"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Flying" data-row="fight"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="fight" data-row="fight">1x</td><td class="effect-cell" data-col="Poison" data-row="fight">1x</td><td class="effect-cell" data-col="Dragon" data-row="fight">1x</td><td class="effect-cell" data-col="Fairy" data-row="fight">1x</td><td class="effect-cell" data-col="Ghost" data-row="fight"><span style="color:#F44336;">Null</span></td><td class="effect-cell" data-col="Ice" data-row="fight"><span style="color:#4CAF50;">2x</span></td></tr>
<tr><th class="type-header" data-type="Poison"><img alt="Poison" class="type-icon" src="/assets/images/type_icons/poison.png"/></th><td class="effect-cell" data-col="Fire" data-row="Poison">1x</td><td class="effect-cell" data-col="Grass" data-row="Poison"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Water" data-row="Poison">1x</td><td class="effect-cell" data-col="Electric" data-row="Poison">1x</td><td class="effect-cell" data-col="Dark" data-row="Poison">1x</td><td class="effect-cell" data-col="Light" data-row="Poison">1x</td><td class="effect-cell" data-col="Flying" data-row="Poison">1x</td><td class="effect-cell" data-col="fight" data-row="Poison"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Poison" data-row="Poison"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dragon" data-row="Poison">1x</td><td class="effect-cell" data-col="Fairy" data-row="Poison"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Ghost" data-row="Poison">1x</td><td class="effect-cell" data-col="Ice" data-row="Poison"><span style="color:#F44336;">Null</span></td></tr>
<tr><th class="type-header" data-type="Dragon"><img alt="Dragon" class="type-icon" src="/assets/images/type_icons/dragon.png"/></th><td class="effect-cell" data-col="Fire" data-row="Dragon">1x</td><td class="effect-cell" data-col="Grass" data-row="Dragon">1x</td><td class="effect-cell" data-col="Water" data-row="Dragon">1x</td><td class="effect-cell" data-col="Electric" data-row="Dragon">1x</td><td class="effect-cell" data-col="Dark" data-row="Dragon">1x</td><td class="effect-cell" data-col="Light" data-row="Dragon">1x</td><td class="effect-cell" data-col="Flying" data-row="Dragon">1x</td><td class="effect-cell" data-col="fight" data-row="Dragon">1x</td><td class="effect-cell" data-col="Poison" data-row="Dragon">1x</td><td class="effect-cell" data-col="Dragon" data-row="Dragon"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Fairy" data-row="Dragon"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Ghost" data-row="Dragon">1x</td><td class="effect-cell" data-col="Ice" data-row="Dragon"><span style="color:#FFA500;">Half</span></td></tr>
<tr><th class="type-header" data-type="Fairy"><img alt="Fairy" class="type-icon" src="/assets/images/type_icons/fairy.png"/></th><td class="effect-cell" data-col="Fire" data-row="Fairy"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Grass" data-row="Fairy">1x</td><td class="effect-cell" data-col="Water" data-row="Fairy">1x</td><td class="effect-cell" data-col="Electric" data-row="Fairy">1x</td><td class="effect-cell" data-col="Dark" data-row="Fairy">1x</td><td class="effect-cell" data-col="Light" data-row="Fairy"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Flying" data-row="Fairy">1x</td><td class="effect-cell" data-col="fight" data-row="Fairy">1x</td><td class="effect-cell" data-col="Poison" data-row="Fairy"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Dragon" data-row="Fairy"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Fairy" data-row="Fairy"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Ghost" data-row="Fairy">1x</td><td class="effect-cell" data-col="Ice" data-row="Fairy">1x</td></tr>
<tr><th class="type-header" data-type="Ghost"><img alt="Ghost" class="type-icon" src="/assets/images/type_icons/ghost.png"/></th><td class="effect-cell" data-col="Fire" data-row="Ghost">1x</td><td class="effect-cell" data-col="Grass" data-row="Ghost">1x</td><td class="effect-cell" data-col="Water" data-row="Ghost">1x</td><td class="effect-cell" data-col="Electric" data-row="Ghost">1x</td><td class="effect-cell" data-col="Dark" data-row="Ghost">1x</td><td class="effect-cell" data-col="Light" data-row="Ghost">1x</td><td class="effect-cell" data-col="Flying" data-row="Ghost">1x</td><td class="effect-cell" data-col="fight" data-row="Ghost"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Poison" data-row="Ghost">1x</td><td class="effect-cell" data-col="Dragon" data-row="Ghost">1x</td><td class="effect-cell" data-col="Fairy" data-row="Ghost"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Ghost" data-row="Ghost"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Ice" data-row="Ghost">1x</td></tr>
<tr><th class="type-header" data-type="Ice"><img alt="Ice" class="type-icon" src="/assets/images/type_icons/ice.png"/></th><td class="effect-cell" data-col="Fire" data-row="Ice"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Grass" data-row="Ice"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Water" data-row="Ice"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Electric" data-row="Ice"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Dark" data-row="Ice">1x</td><td class="effect-cell" data-col="Light" data-row="Ice">1x</td><td class="effect-cell" data-col="Flying" data-row="Ice"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="fight" data-row="Ice">1x</td><td class="effect-cell" data-col="Poison" data-row="Ice">1x</td><td class="effect-cell" data-col="Dragon" data-row="Ice"><span style="color:#4CAF50;">2x</span></td><td class="effect-cell" data-col="Fairy" data-row="Ice">1x</td><td class="effect-cell" data-col="Ghost" data-row="Ice"><span style="color:#FFA500;">Half</span></td><td class="effect-cell" data-col="Ice" data-row="Ice"><span style="color:#FFA500;">Half</span></td></tr>

      </a>
    </div>
    
    <nav class="site-nav">
      <div class="nav-left">
        <a href="/" class="nav-button tracker-link">Dex</a>
        <a href="/world" class="nav-button tracker-link">World</a>
        <div class="dropdown">
          <button class="nav-button">Links ▾</button>
          <div class="dropdown-content">
            <a href="https://www.yanakorpgs.com/" target="_blank">Yanako RPGs</a>
            <a href="https://store.steampowered.com/app/2019300/Dokimon_Quest/" target="_blank">Dokimon: Quest</a>
            <a href="https://discord.com/invite/4YUaYNvVHD" target="_blank">Dokimon Discord</a>
            <a href="https://www.yanakorpgs.com/monmae" target="_blank">MonMae (MonTamer Maker)</a>
            <a href="https://discord.gg/fd62AcwAyY" target="_blank">MonMae Discord</a>
            <a href="https://steamcommunity.com/id/knightexcalibur/" target="_blank">KnightExcalibur (Dokidex developer)</a>
          </div>
        </div>
		<a href="/dokitracker" class="nav-button tracker-link">DokiTracker</a>
      </div>
      <div class="nav-center">
        <div class="search-and-toggle">
		  <span style="color: white; margin-right: 8px;">Dark/Light Mode:</span>

</main>

  <!-- Prevent Right Click on Images -->
  <script>
    document.addEventListener('contextmenu', event => {
      if (event.target.tagName === 'IMG') {
        event.preventDefault();
      }
    });
  </script>
<script>
  const toggleSwitch = document.getElementById('dark-mode-toggle');
  const body = document.body;

  function applyTheme(isDark) {
    body.classList.toggle('dark-mode', isDark);
    toggleSwitch.checked = isDark;
    localStorage.setItem('dark-mode', isDark ? 'enabled' : 'disabled');
  }

  toggleSwitch.addEventListener('change', () => {
    applyTheme(toggleSwitch.checked);
    createRadarChart();
  });

// Default to dark mode unless user set to light
if (!localStorage.getItem('dark-mode')) {
  localStorage.setItem('dark-mode', 'enabled');
}

  // Load preference
  const savedTheme = localStorage.getItem('dark-mode');
  applyTheme(savedTheme === 'enabled');
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.querySelector('.links-button');
    const menu = document.querySelector('.dropdown-content');

    if (button && menu) {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        menu.classList.toggle('show');
      });

      document.addEventListener('click', (e) => {
        if (!button.contains(e.target) && !menu.contains(e.target)) {
          menu.classList.remove('show');
        }
      });
    }
  });
</script>
<script>
let radarChart;

function createRadarChart() {
  const canvas = document.getElementById('statRadarChart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (radarChart) radarChart.destroy();
  radarChart = new Chart(ctx, {
    type: 'radar',
    data: {
      labels: ['HP', 'ATK', 'DEF', 'M.ATK', 'M.DEF', 'SPD'],
      datasets: [{
        label: 'dokitracker.html.bak',
        data: null,
        backgroundColor: 'rgba(136, 136, 136, 0.2)', // light gray fill
        borderColor: '#888', // neutral edge
        pointBackgroundColor: [
          '#f66', // HP
          '#f90', // ATK
          '#fc3', // DEF
          '#99f', // M.ATK
          '#6cf', // M.DEF
          '#3cba54'  // SPD
        ],
        pointBorderColor: [
          '#f66', // HP
          '#f90', // ATK
          '#fc3', // DEF
          '#99f', // M.ATK
          '#6cf', // M.DEF
          '#3cba54'  // SPD
        ],
        pointRadius: 5,
        pointHoverRadius: 6,
        borderWidth: 2
      }]
    },
options: {
  responsive: false,
  scales: {
    r: {
      suggestedMin: 0,
      suggestedMax: 177,
      ticks: {
        backdropColor: 'transparent',
        color: document.body.classList.contains("dark-mode") ? "#ffffff" : "#000000",
        font: {
          weight: 'bold'
        }
      },
      pointLabels: {
        font: {
          weight: 'bold'
        },
        color: function(context) {
          const colors = ['#f66', '#f90', '#fc3', '#99f', '#6cf', '#3cba54'];
          return colors[context.index];
        }
      },
      grid: {
        color: document.body.classList.contains("dark-mode") ? "#ffffff" : "#bbbbbb",
      }
    }
  },
  plugins: {
    legend: {
      display: false
    }
  }
}
  });
}
createRadarChart();
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.tab-button');
    const contents = document.querySelectorAll('.tab-content');

    if (tabs.length && contents.length) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById(tab.dataset.tab).classList.add('active');
        });
      });
    }
  });
</script>
<script>
  // Fade in on load
  document.body.classList.add('fade-out');
  window.addEventListener('DOMContentLoaded', () => {
    document.body.classList.remove('fade-out');
    document.body.classList.add('fade-in');
  });

  // Fade out on arrow click
document.querySelectorAll('.nav-arrow').forEach(link => {
  link.addEventListener('click', function(e) {
    e.preventDefault();
    const href = this.href; // Correct for <a> elements
    document.body.classList.remove('fade-in');
    document.body.classList.add('fade-out');
    setTimeout(() => {
      window.location.href = href;
    }, 300);
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const mainImage = document.getElementById("main-monster-image");
  const altImages = document.querySelectorAll(".forms-images img");
  const lockButton = document.getElementById("lockImageBtn");
  const resetButton = document.getElementById("resetToDefaultBtn");

  if (!mainImage || !lockButton || !resetButton) {
    return;
  }

  const monsterName = mainImage?.dataset?.name;
  const defaultImage = mainImage?.dataset?.default;
  const localStorageKey = `dokimon_locked_image_${monsterName}`;
  const lockStateKey = `dokimon_lock_state_${monsterName}`;

  function updateLockVisualState(isLocked) {
    lockButton.textContent = isLocked ? '🔒' : '🔓';
    lockButton.setAttribute('aria-pressed', isLocked);
  }

  // Load from localStorage on page load
  const savedImage = localStorage.getItem(localStorageKey);
  const savedLockState = localStorage.getItem(lockStateKey) === 'true';

  if (savedImage) {
    mainImage.src = savedImage;
  }

  updateLockVisualState(savedLockState);

  // Click rare form images
  altImages.forEach(img => {
    img.addEventListener("click", () => {
      const isLocked = lockButton.getAttribute('aria-pressed') === 'true';
      if (isLocked) return;
      mainImage.src = img.src;
    });
  });

  // Toggle lock button
  lockButton.addEventListener("click", () => {
    const isLocked = lockButton.getAttribute('aria-pressed') === 'true';
    const newLocked = !isLocked;

    updateLockVisualState(newLocked);
    localStorage.setItem(lockStateKey, newLocked);

    if (newLocked) {
      localStorage.setItem(localStorageKey, mainImage.src);
    } else {
      localStorage.removeItem(localStorageKey);
    }
  });

  // Default reset
  resetButton.addEventListener("click", () => {
    mainImage.src = defaultImage;
    localStorage.removeItem(localStorageKey);
    localStorage.setItem(lockStateKey, false);
    updateLockVisualState(false);
  });
});
</script>


  <script src="/assets/js/mondex_data.js"></script>

  <script src="/assets/js/dokitracker.js"></script>


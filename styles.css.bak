.border-poison-flying {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, #8E44AD, #95A5A6) 1;
  animation: pulse-poison-flying 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-poison-flying {

/* Monster profile image glow */
@keyframes pulseGlow {
  0% {
    box-shadow: 0 0 0px rgba(255, 255, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.9);
  }
  100% {
    box-shadow: 0 0 0px rgba(255, 255, 255, 0.4);
  }
}
.border-fire-grass {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, var(--fire-color), var(--grass-color)) 1;
  animation: pulse-fire-grass 2.5s ease-in-out infinite alternate;
}

@keyframes pulse-fire-grass {
  0% { box-shadow: 0 0 0px var(--fire-color), 0 0 0px var(--grass-color); }
  100% { box-shadow: 0 0 20px var(--fire-color), 0 0 35px var(--grass-color); }
}



.border-ghost-light {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, var(--ghost-color), var(--light-color)) 1;
  animation: pulse-ghost-light 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-ghost-light {
  0% { box-shadow: 0 0 0px var(--ghost-color), 0 0 0px var(--light-color); }
  100% { box-shadow: 0 0 20px var(--ghost-color), 0 0 35px var(--light-color); }
}

/* grass-ice */
.border-grass-ice {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, var(--grass-color), var(--ice-color)) 1;
  animation: pulse-grass-ice 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-grass-ice {
  0% { box-shadow: 0 0 0px var(--grass-color), 0 0 0px var(--ice-color); }
  100% { box-shadow: 0 0 20px var(--grass-color), 0 0 35px var(--ice-color); }
}

/* grass-water */
.border-grass-water {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, var(--grass-color), var(--water-color)) 1;
  animation: pulse-grass-water 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-grass-water {
  0% { box-shadow: 0 0 0px var(--grass-color), 0 0 0px var(--water-color); }
  100% { box-shadow: 0 0 20px var(--grass-color), 0 0 35px var(--water-color); }
}

.border-water-elect {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, #4E9FEF, #FFD93B) 1;
  animation: pulse-water-elect 2.5s ease-in-out infinite alternate;
}

@keyframes pulse-water-elect {
  0% {
    box-shadow: 0 0 0px #4E9FEF, 0 0 0px #FFD93B;
  }
  100% {
    box-shadow: 0 0 20px #4E9FEF, 0 0 35px #FFD93B;
  }
}

.border-grass-flying {
  border: 4px solid transparent;

  }
  100% {
    box-shadow: 0 0 20px #B63E2D, 0 0 35px #6381FF;
  }
}

.border-dragon-ice {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, #6381FF, #88E2F2) 1;
  animation: pulse-dragon-ice 2.5s ease-in-out infinite alternate;
}

@keyframes pulse-dragon-ice {

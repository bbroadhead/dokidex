.border-water-poison {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, #3498DB, #8E44AD) 1;
  animation: pulse-water-poison 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-water-poison {
  0% { box-shadow: 0 0 0px #3498DB, 0 0 0px #8E44AD; }
  100% { box-shadow: 0 0 20px #3498DB, 0 0 35px #8E44AD; }
}

.type-btn {
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 9999px;
  color: #000;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.15s ease-in-out;
  margin: 0.2rem;
  font-family: 'VT323', monospace;
  font-size: 18px;
  line-height: 1.2;
}

.type-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 8px rgba(0,0,0,0.3);
}

.type-btn.active {
  background-color: #aaa !important;
  color: #000 !important; /* keep text black even when selected */
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.4);
  transform: translateY(2px);
  border: 2px solid var(--border-color);
}

/* Color-coded types */
.type-fire     { background-color: var(--fire-color); --border-color: var(--fire-color); }
.type-water    { background-color: var(--water-color); --border-color: var(--water-color); }
.type-grass    { background-color: var(--grass-color); --border-color: var(--grass-color); }
.type-electric { background-color: var(--electric-color); --border-color: var(--electric-color); }
.type-light    { background-color: var(--light-color); --border-color: var(--light-color); }
.type-dark     { background-color: var(--dark-color); --border-color: var(--dark-color); }
.type-flying   { background-color: var(--flying-color); --border-color: var(--flying-color); }
.type-fight    { background-color: var(--fight-color); --border-color: var(--fight-color); }
.type-fairy    { background-color: var(--fairy-color); --border-color: var(--fairy-color); }
.type-ghost    { background-color: var(--ghost-color); --border-color: var(--ghost-color); }
.type-poison   { background-color: var(--poison-color); --border-color: var(--poison-color); }
.type-dragon   { background-color: var(--dragon-color); --border-color: var(--dragon-color); }
.type-ice      { background-color: var(--ice-color); --border-color: var(--ice-color); }

.filter-row {
  width: 100%;
  margin-bottom: 0.5rem;
}

#type-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-block {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 0;
  margin-top: 0;
}

.type-block {
  max-width: 600px;
}

#filters {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
  padding-top: 0;
  margin-top: 0;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  min-width: 200px;
}

.stats-and-forms {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  flex-wrap: nowrap;  /* force side-by-side */
  gap: 1rem;
}

.forms-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -20px;
  padding-top: 0;
  width: fit-content;
  max-width: 300px;
  position: relative;
}

.forms-extra-row {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 32px;
  margin-top: 0;
  position: relative;
}

.forms-separator {
  width: 100%;
  border: none;
  border-top: 2px solid var(--forms-border-color);
  margin: 0;
  display: block;
}

.forms-separator-vertical {
  width: 2px;
  background-color: var(--forms-border-color);
  min-height: 115px;
  height: 100%;
  margin-top: 0;
}

.forms-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 0;
  translateY: 100px;
}

.special-forms-wrapper {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-top: 0;
  flex-wrap: wrap;
}

.forms-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 1rem;
  padding: 0;
  margin-left: 0.25rem;
  margin-right: 0.25rem;
  width: fit-content;
  border: 3px solid var(--forms-border-color);
  background-color: transparent;
}

.special-forms-wrapper .forms-container {
  width: auto;
}

.forms-label {
  padding: 0.2rem 0.6rem;
  border-radius: 0.5rem;
  font-weight: bold;
  margin-bottom: 0.8rem;
  margin-top: 0;
  background-color: var(--forms-label-bg);
  color: var(--forms-label-color);
  text-align: center;
  border: 2px solid var(--forms-border-color);
}

.forms-images {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.4rem;
  padding-bottom: 1rem;
}

.forms-images img {
  image-rendering: pixelated;
  width: auto;
  height: auto;
  max-width: 64px;
  max-height: 64px;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.forms-images img:hover {
  transform: scale(1.05);
}

#resetToDefaultBtn {
  font-size: 0.9rem;
  border-radius: 6px;
  border: 1px solid #aaa;
  background-color: #f8f8f8;
  color: #000;
  cursor: pointer;
}

#resetToDefaultBtn:hover {
  background-color: #eee;
}
body.dark #resetToDefaultBtn {
  background-color: #444;
  color: #fff;
  border-color: #888;
}

.lock-reset-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.1rem;
  flex-wrap: wrap;
}

.lock-button {
  font-size: 1.2rem;
  background: none;
  border: none;
  cursor: pointer;
  outline: none;
  transition: transform 0.2s ease;
}

.lock-button[aria-pressed="true"] {
  color: #e63946;
}

.lock-button:hover {
  transform: scale(1.1);
}

.lock-label {
  margin-right: 0.5rem;
}

/* Light and Dark theme support */
:root {
  --forms-label-bg: #ffffff;
  --forms-label-color: #000000;
  --forms-border-color: #888888;
}

.dark-mode {
  --forms-label-bg: #333333;
  --forms-label-color: #ffffff;
  --forms-border-color: #cccccc;
}

/*
.mini-map-container {
  margin-top: 2rem;
  text-align: center;
}

.mini-map-wrapper {
  position: relative;
  display: inline-block;
  transform: scale(0.5);
  transform-origin: top left;
}

.mini-map {
  width: auto;
  height: auto;
  max-width: none;
}

.mini-sprite {
  position: absolute;
  width: 24px;
  height: 24px;
  animation: blink 1s infinite;
  image-rendering: pixelated;
  z-index: 10;
}

@keyframes blink {
  0%, 50%, 100% { opacity: 1; }
  25%, 75% { opacity: 0; }
}
*/
.nav-arrows {
  position: fixed;
  top: 50%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  transform: translateY(-50%);
  z-index: 100;
  pointer-events: none;
  padding: 0 1rem; /* prevent edges from being cut off */
  box-sizing: border-box;
}

.nav-arrow {
  position: fixed;
  top: 50%;
  transform: translateY(25%);
  width: 20px;
  height: 80px;
  background-color: transparent;
  border: 2px solid var(--arrow-border-color);
  color: var(--arrow-border-color);
  font-size: 1rem;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  transition: all 0.3s ease;
  text-decoration: none;
  pointer-events: auto;
  transform: translateY(60px);
}

.left-arrow {
  left: 1rem;
}

.right-arrow {
  right: 1rem;
}

.nav-arrow a {
  color: inherit;
  text-decoration: none;
  display: block;
  width: 80%;
  height: 100%;
  text-align: center;
  line-height: 60px;
}

.nav-arrow:hover {
  background-color: #e0e0e0;
}

.dark-mode .nav-arrow {
  border-color: #ddd;
  color: #ddd;
}

.dark-mode .nav-arrow:hover {
  background-color: #444;
}

/* Smooth transition effect */
body.fade-out {
  opacity: 0;
  transition: opacity 0.5s ease;
}

body.fade-in {
  opacity: 1;
  transition: opacity 0.5s ease;
}

/* Default layout for large screens */
.monster-layout-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: nowrap;
  gap: 1rem;
}

/* Mobile layout */
@media (max-width: 768px) {
  .monster-layout-row {
    flex-direction: column;
    align-items: center;
  }

  .monster-image-container {
    order: 1;
  }

  .monster-info {
    order: 2;
  }

  .stats-side {
    order: 3;
  }
  
  .forms-wrapper {
	order: 4;
	margin-top: 0;
	padding-left: 2rem;
  }

  .monster-image-container,
  .monster-info,
  .stats-side,
  .forms-wrapper,  {
    width: 100%;
	margin: 0 auto !important;
    max-width: 100%;
    text-align: center;
  }
}

/* Base style for all nav-left items */
.nav-left a,
.nav-left .nav-button,
.nav-left .dropdown > button {
  display: inline-block;
  background-color: #4477aa;
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  margin-right: 0.1rem;
  margin-left: 0.1rem;
  border-radius: 6px;
  font-weight: bold;
  font-size: 1.25rem;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease;
  line-height: 1;
  white-space: nowrap;
}

.nav-button.tracker-link {
	display: inline-block;
	padding-right: 4rem;
}

/* Hover effect */
.nav-left a:hover,
.nav-left .nav-button:hover,
.nav-left .dropdown > button:hover {
  background-color: #5599cc;
}

/* Fix dropdown layout */
.dropdown {
  position: relative;
  display: inline-block;
}

.dropdown-content {
  display: none;
  position: absolute;
  background-color: #4477aa;
  padding: 0.5rem;
  border-radius: 6px;
  top: 100%;
  left: 0;
  z-index: 99;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

.dropdown:hover .dropdown-content {
  display: block;
}

.dropdown-content a {
  display: block;
  padding: 0.4rem 1rem;
  color: white;
  border-radius: 4px;
  text-decoration: none;
  font-weight: bold;
}

.dropdown-content a:hover {
  background-color: #5599cc;
}


/* Dark mode definitions */

body.dark-mode {
  --bg-color: #121212;
  --text-color: #f5f5f5;
  --card-bg: #1e1e1e;
  --border-color: #333333;
  --link-color: #4aa8ff;
}

body.dark-mode #filters {
  background-color: #1e1e1e;
}

body.dark-mode .site-nav {
  background-color: #000;
}

body.dark-mode .site-nav a {
  color: var(--text-color);
}

body.dark-mode .header-bg {
  background: linear-gradient(to right, #000000, #1e1e1e);
}

body.dark-mode .dex-entry {
  border-color: #444;
}

body.dark-mode .dex-entry .dex-name,
body.dark-mode .dex-entry h2,
body.dark-mode .dex-entry p {
  color: white;
}

body.dark-mode .dex-name {
  color: white !important;
}

body.dark-mode .monster-image-container .glow-wrapper {
  background-color: #2a2a2a !important;
}

body.dark-mode .dex-entry img {
  background-color: #2a2a2a;
}

body.dark-mode .dropdown-content {
  background-color: #000;
  border: 1px solid #444;
}

body.dark-mode .dropdown-content a {
  color: #fff;
}

body.dark-mode .dropdown-content a:hover {
  background-color: #1e1e1e;
}

/* Dark Mode: Monster Profile */
body.dark-mode .monster-profile {
  background-color: #1e1e1e;
  color: white;
}

/* Make sure text inside also switches to white */
body.dark-mode .monster-profile *,
body.dark-mode .monster-profile .stat-label {
  color: white;
}

/* EXCEPTION: Don't override stat name boxes (HP, ATK, etc.) */
body.dark-mode .monster-profile .base-stat-label {
  color: inherit;       /* Keep as-is */
  background-color: inherit; /* Do not force dark bg */
}

body.dark-mode .monster-stats th.hp,
body.dark-mode .monster-stats th.atk,
body.dark-mode .monster-stats th.def,
body.dark-mode .monster-stats th.matk,
body.dark-mode .monster-stats th.mdef,
body.dark-mode .monster-stats th.spd {
  color: black;
}

body.dark-mode .dex-entry a {
  color: white !important;
}

body.dark-mode .dex-entry a:visited {
  color: #ccc !important;
}

.monster-profile,
.monster-upper,
.monster-image-container,
.glow-wrapper {
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

body.dark-mode .monster-image-container {
  background-color: transparent !important;
  border-radius: 0 !important;
}
body.dark-mode .nav-button:hover {
  background-color: #1e1e1e;
}
.tab-container {
  margin-top: 1rem;
}

.tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.tab-button {
  padding: 0.5rem 1rem;
  border: none;
  background: #ccc;
  cursor: pointer;
  font-weight: bold;
  border-radius: 6px;
  transition: background 0.3s;
}

.tab-button.active {
  background: #666;
  color: white;
}

body.dark-mode .tab-button {
  background: #444;
  color: #ddd;
}

body.dark-mode .tab-button.active {
  background: #888;
  color: white;
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

/* Dark mode nav buttons */
body.dark-mode .nav-left a,
body.dark-mode .nav-left .nav-button,
body.dark-mode .nav-left .dropdown > button {
  background-color: #222;
  color: #eee;
}

body.dark-mode .nav-left a:hover,
body.dark-mode .nav-left .nav-button:hover,
body.dark-mode .nav-left .dropdown > button:hover {
  background-color: #444;
}

/* Dark mode dropdown */
body.dark-mode .dropdown-content {
  background-color: #222;
  box-shadow: 0 4px 8px rgba(255, 255, 255, 0.1);
}

body.dark-mode .dropdown-content a {
  color: #eee;
}

body.dark-mode .dropdown-content a:hover {
  background-color: #444;
}

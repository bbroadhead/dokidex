/* light-poison */
.border-light-poison {
  border: 4px solid transparent;
  border-image: linear-gradient(135deg, #FCE883, #8E44AD) 1;
  animation: pulse-light-poison 2.5s ease-in-out infinite alternate;
}
@keyframes pulse-light-poison {
